PORT=4000
BACKEND_URL=http://localhost:8080
BACKEND_TIMEOUT_MS=10000

# Error reporting. Leave SENTRY_DSN empty to turn it off (local and tests).
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# Shared with the web app (same value there). Lets the BFF count its per-address
# rate limit by the browser's address, which the web server forwards, instead of
# by the web server's own. Leave empty locally.
BFF_PROXY_SECRET=
