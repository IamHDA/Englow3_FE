{
  "expo": {
    "name": "Englow3",
    "slug": "englow3",
    "scheme": "englow3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF5FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.englow3.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Englow3 ghi âm giọng nói của bạn để chấm phát âm và bài nói.",
        "NSPhotoLibraryUsageDescription": "Englow3 cần truy cập ảnh để bạn đổi ảnh đại diện và đính kèm ảnh vào bài viết, tin nhắn."
      }
    },
    "android": {
      "package": "com.englow3.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Englow3 ghi âm giọng nói của bạn để chấm phát âm và bài nói."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Englow3 cần truy cập ảnh để bạn đổi ảnh đại diện và đính kèm ảnh vào bài viết, tin nhắn."
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
