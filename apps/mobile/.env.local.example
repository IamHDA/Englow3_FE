# Copy to .env.local. Expo inlines EXPO_PUBLIC_* into the bundle at build time,
# so only values that are safe for anyone holding the app belong here.

# The same Supabase project the web app signs in against.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# The BFF, without a trailing slash. The app calls <url>/graphql and the BFF's
# REST routes under <url>/rest. On an Android emulator a BFF on the host
# machine is http://10.0.2.2:4000, not localhost.
EXPO_PUBLIC_BFF_URL=http://localhost:4000

# The web app; used for links the mobile app hands to the browser (terms,
# privacy, pricing).
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# The backend's chat WebSocket origin, without /ws/chat (same value as the
# web's NEXT_PUBLIC_CHAT_WS_URL). Leave empty to have chat poll instead.
EXPO_PUBLIC_CHAT_WS_URL=
