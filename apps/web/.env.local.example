# Copy to .env.local and replace these placeholders with your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>

# Where the Next.js server finds the BFF. The browser never calls it: it talks to
# this app's own /api/graphql, which adds the session token on the server.
# Change this only when the BFF is not running on localhost:4000.
# BFF_GRAPHQL_URL is server-only; the NEXT_PUBLIC_ name still works as a
# fallback so an existing deployment keeps running without a change.
BFF_GRAPHQL_URL=http://localhost:4000/graphql

# Start inexpensive BE/AI readiness probes on a document navigation.
SERVICE_WARMUP_ENABLED=true

# Shown on the Terms, Privacy and Pricing pages. Leave empty and the pages say
# contact is through the app, and the Pro upgrade button stays off.
NEXT_PUBLIC_OPERATOR_NAME=Englow3
NEXT_PUBLIC_CONTACT_EMAIL=

# The public address of this deployment, for the sitemap, robots.txt and link
# previews. On Vercel it falls back to the project's production URL.
NEXT_PUBLIC_SITE_URL=
