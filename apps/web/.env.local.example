# Copy to .env.local and replace these placeholders with your Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>

# Local Apollo BFF. Change this only when the BFF is not running on localhost:4000.
NEXT_PUBLIC_BFF_GRAPHQL_URL=http://localhost:4000/graphql
