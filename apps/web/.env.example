# Supabase project the browser signs in against. Both values are public:
# the publishable key is designed to ship to the browser and is guarded by
# row level security, not by secrecy. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# GraphQL BFF endpoint.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
